# syntax=docker/dockerfile:1.7
# Opero Web — pnpm workspace image for Railway.
#
# NEXT_PUBLIC_API_BASE_URL is intentionally NOT a Docker build-arg.
# The browser API origin is injected at request time from the runtime env
# (see apps/web/src/components/public-env-script.tsx). Set it on the Railway
# opero-web service variables, e.g.:
#   NEXT_PUBLIC_API_BASE_URL=https://opero-staging.up.railway.app/api/v1
# Origin-only values are accepted and normalized to include /api/v1.
# No secrets belong in NEXT_PUBLIC_* (or API_BASE_URL).
FROM node:24-bookworm-slim AS base
ENV PNPM_HOME=/pnpm
ENV COREPACK_HOME=/pnpm/corepack
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@10.34.9 --activate \
  && apt-get update && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app

FROM base AS build
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json .npmrc ./
COPY apps ./apps
COPY packages ./packages
COPY scripts ./scripts
RUN pnpm install --frozen-lockfile
# Build without NEXT_PUBLIC_* so one image works for staging and production.
RUN pnpm --filter @opero/web... build

FROM base AS runtime
ENV NODE_ENV=production
ENV WEB_HOST=0.0.0.0
ENV HOME=/home/opero
ENV PNPM_HOME=/pnpm
ENV COREPACK_HOME=/pnpm/corepack
ENV PATH=$PNPM_HOME:$PATH
WORKDIR /app
RUN groupadd --system --gid 10001 opero \
  && useradd --system --uid 10001 --gid opero --home-dir /home/opero --create-home --shell /usr/sbin/nologin opero \
  && mkdir -p "$COREPACK_HOME" \
  && chown -R opero:opero /pnpm /home/opero
COPY --from=build --chown=opero:opero /app /app
USER opero
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||process.env.WEB_PORT||3000)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["pnpm", "--filter", "@opero/web", "start"]
