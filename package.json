{
  "name": "opero",
  "private": true,
  "version": "0.0.0",
  "description": "Opero monorepo: web, API, worker, and shared platform packages.",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "pnpm --filter @opero/database db:generate",
    "db:migrate": "pnpm --filter @opero/database db:migrate"
  },
  "devDependencies": {
    "turbo": "2.11.11",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "msgpackr-extract",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
