// Tenant isolation is not enforced by this schema.
// Organization relationships describe ownership. They do not authorize access.
// Every future service that reads or writes tenant data must scope queries by
// organizationId, and that behavior must be tested before a business API is exposed.
// Postgres RLS is not enabled; authorization is enforced in the API.
// Raw financial documents are never stored in PostgreSQL — only object-storage keys.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  ADMIN
  ANALYST
  VIEWER
}

enum DocumentFormat {
  PDF
  XLSX
  CSV
}

enum DocumentProcessingStatus {
  UPLOADED
  QUARANTINED
  SCANNING
  SCANNED
  EXTRACTING
  EXTRACTED
  REVIEW_REQUIRED
  READY
  REJECTED
  FAILED
}

enum DocumentScanStatus {
  PENDING
  CLEAN
  INFECTED
  ERROR
  UNAVAILABLE
}

enum DocumentExtractionStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  MANUAL_REQUIRED
}

enum DocumentDeletionStatus {
  ACTIVE
  PENDING_DELETE
  DELETED
}

enum FailureClass {
  VALIDATION
  MALWARE
  SCANNER_UNAVAILABLE
  PARSER
  TIMEOUT
  STORAGE
  INTERNAL
  UNSUPPORTED
}

enum StatementType {
  INCOME_STATEMENT
  BALANCE_SHEET
  CASH_FLOW
  UNKNOWN
}

enum UnitScale {
  ACTUAL
  THOUSANDS
  MILLIONS
}

enum FinancialConcept {
  REVENUE
  COST_OF_GOODS_SOLD
  GROSS_PROFIT
  OPERATING_EXPENSES
  OPERATING_PROFIT
  NET_PROFIT
  CASH_AND_EQUIVALENTS
  ACCOUNTS_RECEIVABLE
  ACCOUNTS_PAYABLE
  INVENTORY
  CURRENT_ASSETS
  CURRENT_LIABILITIES
  TOTAL_ASSETS
  TOTAL_LIABILITIES
  EQUITY
  INTEREST_BEARING_DEBT
  INTEREST_EXPENSE
  OPERATING_CASH_FLOW
  CAPITAL_EXPENDITURE
  UNMAPPED
}

enum DiagnosticRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum DiagnosticMetricStatus {
  COMPUTED
  UNDEFINED
  INSUFFICIENT_INPUTS
  INCOMPATIBLE
}

enum DiagnosticScoreStatus {
  SCORED
  INSUFFICIENT_DATA
}

enum DiagnosticFindingSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
}

enum DiagnosticFindingCategory {
  OBSERVATION
  RISK
  INVESTIGATION
  DATA_QUALITY
}

enum DiagnosticFindingReviewStatus {
  OPEN
  ACKNOWLEDGED
  DISMISSED
}

enum DiagnosticReviewAction {
  ACKNOWLEDGE
  DISMISS
}

enum ExtractionQuality {
  HIGH
  MEDIUM
  LOW
  MANUAL
}

enum LineItemReviewStatus {
  PENDING
  CONFIRMED
  CORRECTED
  REJECTED
}

enum ReviewAction {
  CONFIRM
  CORRECT
  REJECT
}

enum DocumentAccessAction {
  VIEW
  DOWNLOAD
  DELETE
  UPLOAD
  REVIEW
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships       Membership[]
  invitations       OrganizationInvitation[]
  auditEvents       AuditEvent[]
  documents         Document[]
  documentUploads   DocumentUpload[]
  processingJobs    DocumentProcessingJob[]
  extractions       DocumentExtraction[]
  statements        FinancialStatement[]
  accessEvents      DocumentAccessEvent[]
  diagnosticRuns    DiagnosticRun[]
  diagnosticReviews DiagnosticReview[]

  @@map("organizations")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  name            String
  passwordHash    String    @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  memberships              Membership[]
  sessions                 Session[]
  emailVerificationTokens  EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]
  invitationsSent          OrganizationInvitation[] @relation("InvitationInviter")
  auditEvents              AuditEvent[]
  uploadedDocuments        Document[]               @relation("DocumentUploader")
  documentUploads          DocumentUpload[]         @relation("DocumentUploadActor")
  extractionReviews        ExtractionReview[]
  accessEvents             DocumentAccessEvent[]
  diagnosticRunsInitiated  DiagnosticRun[]          @relation("DiagnosticRunInitiator")
  diagnosticReviews        DiagnosticReview[]

  @@map("users")
}

model Membership {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  role           MembershipRole
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
  @@map("memberships")
}

model Session {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  rotatedFromId  String?   @map("rotated_from_id") @db.Uuid
  ip             String?
  userAgent      String?   @map("user_agent")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model OrganizationInvitation {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  email           String
  role            MembershipRole
  tokenHash       String         @unique @map("token_hash")
  invitedByUserId String         @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime       @map("expires_at")
  consumedAt      DateTime?      @map("consumed_at")
  revokedAt       DateTime?      @map("revoked_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@index([organizationId])
  @@map("organization_invitations")
}

/// Append-only record. Organization context is optional for auth events.
/// Actor deletion keeps the event and clears actorUserId.
/// This is referential integrity, not an authorization policy.
model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  requestId      String?  @map("request_id")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorUserId])
  @@index([organizationId, entityType, entityId])
  @@index([requestId])
  @@map("audit_events")
}

model Document {
  id               String                    @id @default(uuid()) @db.Uuid
  organizationId   String                    @map("organization_id") @db.Uuid
  uploadedByUserId String                    @map("uploaded_by_user_id") @db.Uuid
  originalFilename String                    @map("original_filename")
  mimeType         String                    @map("mime_type")
  format           DocumentFormat
  byteSize         BigInt                    @map("byte_size")
  sha256           String
  storageKey       String                    @map("storage_key")
  quarantineKey    String?                   @map("quarantine_key")
  processingStatus DocumentProcessingStatus  @default(UPLOADED) @map("processing_status")
  scanStatus       DocumentScanStatus        @default(PENDING) @map("scan_status")
  extractionStatus DocumentExtractionStatus  @default(PENDING) @map("extraction_status")
  failureClass     FailureClass?             @map("failure_class")
  failureMessage   String?                   @map("failure_message")
  deletionStatus   DocumentDeletionStatus    @default(ACTIVE) @map("deletion_status")
  deletedAt        DateTime?                 @map("deleted_at")
  retentionUntil   DateTime?                 @map("retention_until")
  uploadedAt       DateTime                  @default(now()) @map("uploaded_at")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  uploadedBy   User                    @relation("DocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  versions     DocumentVersion[]
  uploads      DocumentUpload[]
  jobs         DocumentProcessingJob[]
  extractions  DocumentExtraction[]
  statements   FinancialStatement[]
  accessEvents DocumentAccessEvent[]

  @@unique([organizationId, sha256])
  @@index([organizationId, uploadedAt])
  @@index([organizationId, processingStatus])
  @@index([organizationId, deletionStatus])
  @@map("documents")
}

model DocumentVersion {
  id             String         @id @default(uuid()) @db.Uuid
  documentId     String         @map("document_id") @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  versionNumber  Int            @map("version_number")
  sha256         String
  byteSize       BigInt         @map("byte_size")
  storageKey     String         @map("storage_key")
  format         DocumentFormat
  mimeType       String         @map("mime_type")
  createdAt      DateTime       @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNumber])
  @@index([organizationId, documentId])
  @@map("document_versions")
}

model DocumentUpload {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  actorUserId      String    @map("actor_user_id") @db.Uuid
  documentId       String?   @map("document_id") @db.Uuid
  declaredFilename String    @map("declared_filename")
  declaredMimeType String?   @map("declared_mime_type")
  declaredFormat   DocumentFormat @map("declared_format")
  expectedByteSize BigInt?   @map("expected_byte_size")
  quarantineKey    String    @map("quarantine_key")
  expiresAt        DateTime  @map("expires_at")
  consumedAt       DateTime? @map("consumed_at")
  completedSha256  String?   @map("completed_sha256")
  completedByteSize BigInt?  @map("completed_byte_size")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User         @relation("DocumentUploadActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  document     Document?    @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, expiresAt])
  @@map("document_uploads")
}

model DocumentProcessingJob {
  id               String                   @id @default(uuid()) @db.Uuid
  organizationId   String                   @map("organization_id") @db.Uuid
  documentId       String                   @map("document_id") @db.Uuid
  bullJobId        String?                  @map("bull_job_id")
  status           DocumentProcessingStatus @default(QUARANTINED)
  attemptCount     Int                      @default(0) @map("attempt_count")
  maxAttempts      Int                      @default(5) @map("max_attempts")
  correlationId    String?                  @map("correlation_id")
  actorUserId      String?                  @map("actor_user_id") @db.Uuid
  errorClass       FailureClass?            @map("error_class")
  errorMessage     String?                  @map("error_message")
  startedAt        DateTime?                @map("started_at")
  finishedAt       DateTime?                @map("finished_at")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  document     Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([organizationId, documentId])
  @@index([status, createdAt])
  @@index([correlationId])
  @@map("document_processing_jobs")
}

model DocumentExtraction {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  documentId     String                   @map("document_id") @db.Uuid
  method         String
  quality        ExtractionQuality        @default(MEDIUM)
  status         DocumentExtractionStatus @default(PENDING)
  warnings       Json?
  startedAt      DateTime?                @map("started_at")
  finishedAt     DateTime?                @map("finished_at")
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  document     Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  statements   FinancialStatement[]

  @@index([organizationId, documentId])
  @@map("document_extractions")
}

model FinancialStatement {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  documentId     String               @map("document_id") @db.Uuid
  extractionId   String               @map("extraction_id") @db.Uuid
  statementType  StatementType        @map("statement_type")
  currency       String?
  unitScale      UnitScale            @default(ACTUAL) @map("unit_scale")
  periodStart    DateTime?            @map("period_start") @db.Date
  periodEnd      DateTime?            @map("period_end") @db.Date
  periodLabel    String?              @map("period_label")
  reviewStatus   LineItemReviewStatus @default(PENDING) @map("review_status")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  document     Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  extraction   DocumentExtraction @relation(fields: [extractionId], references: [id], onDelete: Cascade)
  lineItems    FinancialLineItem[]

  @@index([organizationId, documentId])
  @@index([extractionId])
  @@map("financial_statements")
}

model FinancialLineItem {
  id                   String               @id @default(uuid()) @db.Uuid
  organizationId       String               @map("organization_id") @db.Uuid
  statementId          String               @map("statement_id") @db.Uuid
  concept              FinancialConcept
  labelRaw             String               @map("label_raw")
  rawValue             String               @map("raw_value")
  normalizedValue      String?              @map("normalized_value")
  currency             String?
  unitScale            UnitScale            @default(ACTUAL) @map("unit_scale")
  extractionMethod     String               @map("extraction_method")
  quality              ExtractionQuality    @default(MEDIUM)
  reviewStatus         LineItemReviewStatus @default(PENDING) @map("review_status")
  evidenceId           String?              @map("evidence_id") @db.Uuid
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  statement FinancialStatement  @relation(fields: [statementId], references: [id], onDelete: Cascade)
  evidence  EvidenceReference?  @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  reviews   ExtractionReview[]

  @@index([organizationId, statementId])
  @@index([concept])
  @@map("financial_line_items")
}

model EvidenceReference {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  documentId     String   @map("document_id") @db.Uuid
  evidenceKey    String   @unique @map("evidence_key")
  pageNumber     Int?     @map("page_number")
  sheetName      String?  @map("sheet_name")
  cellRef        String?  @map("cell_ref")
  rowIndex       Int?     @map("row_index")
  columnIndex    Int?     @map("column_index")
  snippet        String?
  createdAt      DateTime @default(now()) @map("created_at")

  lineItems FinancialLineItem[]

  @@index([organizationId, documentId])
  @@map("evidence_references")
}

model ExtractionReview {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  lineItemId     String       @map("line_item_id") @db.Uuid
  actorUserId    String       @map("actor_user_id") @db.Uuid
  action         ReviewAction
  previousValue  String?      @map("previous_value")
  newValue       String?      @map("new_value")
  previousConcept FinancialConcept? @map("previous_concept")
  newConcept     FinancialConcept?  @map("new_concept")
  reason         String?
  createdAt      DateTime     @default(now()) @map("created_at")

  lineItem FinancialLineItem @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  actor    User              @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, lineItemId])
  @@index([actorUserId])
  @@map("extraction_reviews")
}

model DocumentAccessEvent {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  documentId     String               @map("document_id") @db.Uuid
  actorUserId    String?              @map("actor_user_id") @db.Uuid
  action         DocumentAccessAction
  requestId      String?              @map("request_id")
  metadata       Json?
  createdAt      DateTime             @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  document     Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, documentId, createdAt])
  @@map("document_access_events")
}

model DiagnosticRuleVersion {
  id          String   @id @default(uuid()) @db.Uuid
  ruleSetId   String   @map("rule_set_id")
  ruleId      String   @map("rule_id")
  version     String
  title       String
  description String
  category    DiagnosticFindingCategory
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  findings DiagnosticFinding[]

  @@unique([ruleSetId, ruleId, version])
  @@index([ruleSetId, version])
  @@map("diagnostic_rule_versions")
}

model DiagnosticRun {
  id                       String              @id @default(uuid()) @db.Uuid
  organizationId           String              @map("organization_id") @db.Uuid
  initiatedByUserId        String              @map("initiated_by_user_id") @db.Uuid
  status                   DiagnosticRunStatus @default(QUEUED)
  currency                 String?
  periodStart              DateTime?           @map("period_start") @db.Date
  periodEnd                DateTime?           @map("period_end") @db.Date
  periodLabel              String?             @map("period_label")
  calculationEngineVersion String              @map("calculation_engine_version")
  ruleSetVersion           String              @map("rule_set_version")
  scoreMethodologyVersion  String              @map("score_methodology_version")
  failureClass             FailureClass?       @map("failure_class")
  failureMessage           String?             @map("failure_message")
  bullJobId                String?             @map("bull_job_id")
  requestId                String?             @map("request_id")
  startedAt                DateTime?           @map("started_at")
  completedAt              DateTime?           @map("completed_at")
  createdAt                DateTime            @default(now()) @map("created_at")
  updatedAt                DateTime            @updatedAt @map("updated_at")

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  initiatedBy  User                     @relation("DiagnosticRunInitiator", fields: [initiatedByUserId], references: [id], onDelete: Restrict)
  snapshot     DiagnosticInputSnapshot?
  metrics      FinancialMetric[]
  quality      DataQualityAssessment?
  score        DiagnosticScore?
  findings     DiagnosticFinding[]
  reviews      DiagnosticReview[]

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@map("diagnostic_runs")
}

model DiagnosticInputSnapshot {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  diagnosticRunId  String   @unique @map("diagnostic_run_id") @db.Uuid
  contentHash      String   @map("content_hash")
  payload          Json
  documentIds      String[] @map("document_ids") @db.Uuid
  extractionIds    String[] @map("extraction_ids") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  run DiagnosticRun @relation(fields: [diagnosticRunId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("diagnostic_input_snapshots")
}

model FinancialMetric {
  id              String                 @id @default(uuid()) @db.Uuid
  organizationId  String                 @map("organization_id") @db.Uuid
  diagnosticRunId String                 @map("diagnostic_run_id") @db.Uuid
  code            String
  label           String
  dimension       String
  status          DiagnosticMetricStatus
  value           String?
  unit            String?
  formulaId       String                 @map("formula_id")
  periodStart     DateTime?              @map("period_start") @db.Date
  periodEnd       DateTime?              @map("period_end") @db.Date
  periodLabel     String?                @map("period_label")
  inputRefs       Json?                  @map("input_refs")
  warnings        Json?
  createdAt       DateTime               @default(now()) @map("created_at")

  run DiagnosticRun @relation(fields: [diagnosticRunId], references: [id], onDelete: Cascade)

  @@index([organizationId, diagnosticRunId])
  @@index([diagnosticRunId, code])
  @@map("financial_metrics")
}

model DataQualityAssessment {
  id                    String   @id @default(uuid()) @db.Uuid
  organizationId        String   @map("organization_id") @db.Uuid
  diagnosticRunId       String   @unique @map("diagnostic_run_id") @db.Uuid
  completeness          String
  consistency           String
  evidenceReliability   String   @map("evidence_reliability")
  diagnosticCoverage    String   @map("diagnostic_coverage")
  details               Json?
  createdAt             DateTime @default(now()) @map("created_at")

  run DiagnosticRun @relation(fields: [diagnosticRunId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("data_quality_assessments")
}

model DiagnosticScore {
  id              String                 @id @default(uuid()) @db.Uuid
  organizationId  String                 @map("organization_id") @db.Uuid
  diagnosticRunId String                 @unique @map("diagnostic_run_id") @db.Uuid
  status          DiagnosticScoreStatus
  overallScore    Int?                   @map("overall_score")
  methodologyVersion String              @map("methodology_version")
  limitations     Json?
  createdAt       DateTime               @default(now()) @map("created_at")

  run        DiagnosticRun    @relation(fields: [diagnosticRunId], references: [id], onDelete: Cascade)
  components ScoreComponent[]

  @@index([organizationId])
  @@map("diagnostic_scores")
}

model ScoreComponent {
  id                 String  @id @default(uuid()) @db.Uuid
  organizationId     String  @map("organization_id") @db.Uuid
  diagnosticScoreId  String  @map("diagnostic_score_id") @db.Uuid
  dimension          String
  weight             Int
  included           Boolean
  score              Int?
  exclusionReason    String? @map("exclusion_reason")
  metricCodes        String[] @map("metric_codes")

  scoreRow DiagnosticScore @relation(fields: [diagnosticScoreId], references: [id], onDelete: Cascade)

  @@index([organizationId, diagnosticScoreId])
  @@map("score_components")
}

model DiagnosticFinding {
  id                 String                        @id @default(uuid()) @db.Uuid
  organizationId     String                        @map("organization_id") @db.Uuid
  diagnosticRunId    String                        @map("diagnostic_run_id") @db.Uuid
  ruleVersionId      String?                       @map("rule_version_id") @db.Uuid
  ruleId             String                        @map("rule_id")
  ruleSetVersion     String                        @map("rule_set_version")
  category           DiagnosticFindingCategory
  severity           DiagnosticFindingSeverity
  title              String
  explanation        String
  implication        String
  suggestedAction    String                        @map("suggested_action")
  confidence         String
  supportingMetrics  String[]                      @map("supporting_metrics")
  reviewStatus       DiagnosticFindingReviewStatus @default(OPEN) @map("review_status")
  createdAt          DateTime                      @default(now()) @map("created_at")

  run         DiagnosticRun               @relation(fields: [diagnosticRunId], references: [id], onDelete: Cascade)
  ruleVersion DiagnosticRuleVersion?      @relation(fields: [ruleVersionId], references: [id], onDelete: SetNull)
  evidence    DiagnosticEvidenceLink[]
  reviews     DiagnosticReview[]

  @@index([organizationId, diagnosticRunId])
  @@index([diagnosticRunId, ruleId])
  @@map("diagnostic_findings")
}

model DiagnosticEvidenceLink {
  id                   String  @id @default(uuid()) @db.Uuid
  organizationId       String  @map("organization_id") @db.Uuid
  findingId            String  @map("finding_id") @db.Uuid
  documentId           String? @map("document_id") @db.Uuid
  lineItemId           String? @map("line_item_id") @db.Uuid
  evidenceReferenceId  String? @map("evidence_reference_id") @db.Uuid
  snapshotKey          String  @map("snapshot_key")
  label                String?

  finding DiagnosticFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([organizationId, findingId])
  @@map("diagnostic_evidence_links")
}

model DiagnosticReview {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  diagnosticRunId String                 @map("diagnostic_run_id") @db.Uuid
  findingId      String?                 @map("finding_id") @db.Uuid
  actorUserId    String                  @map("actor_user_id") @db.Uuid
  action         DiagnosticReviewAction
  note           String?
  createdAt      DateTime                @default(now()) @map("created_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  run          DiagnosticRun      @relation(fields: [diagnosticRunId], references: [id], onDelete: Cascade)
  finding      DiagnosticFinding? @relation(fields: [findingId], references: [id], onDelete: SetNull)
  actor        User               @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, diagnosticRunId])
  @@map("diagnostic_reviews")
}
