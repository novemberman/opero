# Local development only. Copy to .env and replace every placeholder.
# Never commit .env. Never reuse these values outside a loopback development environment.

NODE_ENV=development
# APP_ENV distinguishes staging vs production when NODE_ENV=production on Railway.
# APP_ENV=development
APP_VERSION=dev
LOG_LEVEL=info
# TRUST_PROXY=true when behind Railway/TLS terminator
TRUST_PROXY=false

# Web (Next.js). Bound to loopback by default.
WEB_HOST=127.0.0.1
WEB_PORT=3000

# API (NestJS). Bound to loopback by default.
API_HOST=127.0.0.1
API_PORT=3001
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# PostgreSQL. Published on 127.0.0.1 only. Port 54329 avoids the default 5432.
POSTGRES_USER=opero
POSTGRES_PASSWORD=replace-with-local-dev-password
POSTGRES_DB=opero
POSTGRES_PORT=54329
DATABASE_URL=postgresql://opero:replace-with-local-dev-password@127.0.0.1:54329/opero?schema=public

# Redis. Published on 127.0.0.1 only. Port 63799 avoids the default 6379.
REDIS_HOST=127.0.0.1
REDIS_PORT=63799
REDIS_PASSWORD=replace-with-local-dev-password
REDIS_URL=redis://:replace-with-local-dev-password@127.0.0.1:63799

# Phase 3 auth / sessions (API)
APP_ORIGIN=http://127.0.0.1:3000
SESSION_COOKIE_NAME=opero_session
CSRF_COOKIE_NAME=opero_csrf
CSRF_SECRET=replace-with-long-random-secret-at-least-32-chars
SESSION_TTL_HOURS=168
AUTH_TOKEN_TTL_HOURS=24
MAIL_DRIVER=dev
MAIL_DIR=.data/mail

# Auth rate limiting (API). AUTH_THROTTLE_DISABLED is forbidden when NODE_ENV=production.
AUTH_THROTTLE_DISABLED=false
AUTH_LOGIN_THROTTLE_LIMIT=10
AUTH_LOGIN_THROTTLE_TTL_MS=60000

# Web browser calls to the API (optional override)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3001/api/v1

# Phase 4 — private object storage.
# Browser uploads are API-mediated (multipart to Nest), never direct browser→storage.
# filesystem: private local directories under DOCUMENT_STORAGE_ROOT (default for local MVP).
# s3: managed S3-compatible provider (Railway buckets, MinIO, etc.).
DOCUMENT_STORAGE_DRIVER=filesystem
DOCUMENT_STORAGE_ROOT=.data/object-storage
# Local MinIO: docker compose --profile s3 up -d minio
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-with-s3-access-key
S3_SECRET_ACCESS_KEY=replace-with-s3-secret-at-least-8-chars
S3_FORCE_PATH_STYLE=true
S3_SSE=none
S3_QUARANTINE_BUCKET=opero-quarantine
S3_DOCUMENTS_BUCKET=opero-documents
# S3_REPORTS_BUCKET=opero-reports
S3_PRESIGN_TTL_SECONDS=120

# Document limits and retention (20 MB MVP limit)
DOCUMENT_MAX_BYTES=20971520
DOCUMENT_UPLOAD_TTL_MINUTES=30
DOCUMENT_RETENTION_DAYS=365

# Malware scanning (ClamAV). Fail closed when unavailable unless driver=mock (tests only).
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
DOCUMENT_SCANNER_DRIVER=clamav

# Phase 6 — AI interpretation (mock by default; tests never call the network).
# Production must not present mock output as live AI.
AI_PROVIDER=mock
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=1
AI_SHARE_STRUCTURED_CONTEXT=true

# Phase 7A — Billing (Korapay). Default mock never contacts the network.
# Never put secret keys in frontend code. Never commit real secrets.
# Production forbids PAYMENT_PROVIDER=mock and sk_test_ keys.
PAYMENT_PROVIDER=mock
# PAYMENT_PROVIDER=korapay
# KORAPAY_SECRET_KEY=sk_test_replace_me
# KORAPAY_PUBLIC_KEY=pk_test_replace_me
KORAPAY_BASE_URL=https://api.korapay.com
# Public API base (including /api/v1). Used to build Korapay notification_url:
#   {BILLING_WEBHOOK_BASE_URL}/billing/webhooks/korapay
# No secrets in the URL. Also configure this same path in Korapay dashboard
# Settings → API Configuration. Do not expose localdev solely for webhooks.
# BILLING_WEBHOOK_BASE_URL=https://api.example.com/api/v1

# Staging/production templates (placeholders only):
#   .env.staging.example
#   .env.production.example
# Deployment plan: docs/PHASE7B1_DEPLOYMENT.md

