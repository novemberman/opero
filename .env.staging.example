# Staging placeholders only. Set real values in Railway. Never commit secrets.
NODE_ENV=production
APP_ENV=staging
APP_VERSION=replace-with-git-sha
TRUST_PROXY=true
LOG_LEVEL=info

WEB_HOST=0.0.0.0
WEB_PORT=3000
API_HOST=0.0.0.0
API_PORT=3001
APP_ORIGIN=https://staging.example.com
CORS_ORIGINS=https://staging.example.com
NEXT_PUBLIC_API_BASE_URL=https://api.staging.example.com/api/v1
BILLING_WEBHOOK_BASE_URL=https://api.staging.example.com/api/v1

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/opero_staging?schema=public
REDIS_HOST=redis.internal
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-staging-redis-password

CSRF_SECRET=replace-with-staging-csrf-secret-at-least-32-chars
COOKIE_SECURE=true
SESSION_COOKIE_NAME=opero_session
CSRF_COOKIE_NAME=opero_csrf
MAIL_DRIVER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=
MAIL_TIMEOUT_MS=15000

DOCUMENT_STORAGE_DRIVER=s3
S3_ENDPOINT=https://s3.example.com
S3_REGION=auto
S3_ACCESS_KEY_ID=replace-with-staging-access-key
S3_SECRET_ACCESS_KEY=replace-with-staging-secret
S3_FORCE_PATH_STYLE=true
S3_SSE=AES256
S3_QUARANTINE_BUCKET=opero-stg-quarantine
S3_DOCUMENTS_BUCKET=opero-stg-documents
S3_REPORTS_BUCKET=opero-stg-reports

DOCUMENT_SCANNER_DRIVER=clamav
CLAMAV_HOST=clamav.internal
CLAMAV_PORT=3310

AI_PROVIDER=openai
OPENAI_API_KEY=replace-with-staging-openai-key
OPENAI_MODEL=gpt-4o-mini

PAYMENT_PROVIDER=korapay
KORAPAY_SECRET_KEY=sk_test_replace_me
KORAPAY_PUBLIC_KEY=pk_test_replace_me
KORAPAY_BASE_URL=https://api.korapay.com
