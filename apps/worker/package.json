{
  "name": "@opero/worker",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "predev": "pnpm --filter @opero/shared --filter @opero/document-processing --filter @opero/object-storage --filter @opero/diagnostics build",
    "dev": "nest start --watch",
    "prebuild": "pnpm --filter @opero/shared --filter @opero/document-processing --filter @opero/object-storage --filter @opero/diagnostics build",
    "build": "nest build",
    "start": "node --import tsx dist/main.js",
    "lint": "eslint .",
    "pretypecheck": "pnpm --filter @opero/shared --filter @opero/document-processing --filter @opero/object-storage --filter @opero/diagnostics build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @opero/shared --filter @opero/document-processing --filter @opero/object-storage --filter @opero/diagnostics build",
    "test": "vitest run"
  },

  "dependencies": {
    "@nestjs/bullmq": "12.0.1",
    "@nestjs/common": "12.5.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.5.0",
    "@opero/database": "workspace:*",
    "@opero/diagnostics": "workspace:*",
    "@opero/document-processing": "workspace:*",
    "@opero/object-storage": "workspace:*",
    "@opero/shared": "workspace:*",
    "bullmq": "6.7.5",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "pino-pretty": "13.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.12",
    "@nestjs/schematics": "12.0.13",
    "@nestjs/testing": "12.5.0",
    "@opero/eslint-config": "workspace:*",
    "@opero/typescript-config": "workspace:*",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
