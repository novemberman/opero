{
  "name": "@opero/api",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "predev": "pnpm --filter @opero/shared --filter @opero/document-processing --filter @opero/object-storage build",
    "dev": "nest start --watch",
    "prebuild": "pnpm --filter @opero/shared --filter @opero/document-processing --filter @opero/object-storage build",
    "build": "nest build",
    "start": "node --import tsx dist/main.js",
    "lint": "eslint .",
    "pretypecheck": "pnpm --filter @opero/shared --filter @opero/document-processing --filter @opero/object-storage build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @opero/shared --filter @opero/document-processing --filter @opero/object-storage build",
    "test": "vitest run"
  },

  "dependencies": {
    "@nestjs/bullmq": "12.0.1",
    "@nestjs/common": "12.5.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "@nestjs/swagger": "^12.1.1",
    "@nestjs/throttler": "^6.7.1",
    "@opero/database": "workspace:*",
    "@opero/document-processing": "workspace:*",
    "@opero/object-storage": "workspace:*",
    "@opero/shared": "workspace:*",
    "argon2": "^0.45.2",
    "bullmq": "6.7.5",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^4.1.0",
    "ioredis": "6.0.0",
    "multer": "^2.5.0",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "pino-pretty": "13.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.12",
    "@nestjs/schematics": "12.0.13",
    "@nestjs/testing": "12.5.0",
    "@opero/eslint-config": "workspace:*",
    "@opero/typescript-config": "workspace:*",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "dotenv": "18.0.10",
    "eslint": "10.14.0",
    "supertest": "7.3.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
