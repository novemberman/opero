{
  "name": "@opero/web",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "predev": "pnpm --filter @opero/shared build",
    "dev": "node scripts/next.mjs dev",
    "prebuild": "pnpm --filter @opero/shared build",
    "build": "next build",
    "start": "node scripts/next.mjs start",
    "lint": "eslint .",
    "pretypecheck": "pnpm --filter @opero/shared build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @opero/shared build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@opero/shared": "workspace:*",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@opero/typescript-config": "workspace:*",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.10",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.6",
    "happy-dom": "20.0.0",
    "jsdom": "27.0.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
