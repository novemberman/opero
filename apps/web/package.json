{
  "name": "@opero/web",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "predev": "pnpm --filter @opero/shared build",
    "dev": "node scripts/next.mjs dev",
    "prebuild": "pnpm --filter @opero/shared build",
    "build": "next build",
    "start": "node scripts/next.mjs start",
    "lint": "eslint .",
    "pretypecheck": "pnpm --filter @opero/shared build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @opero/shared build",
    "test": "vitest run"
  },
  "dependencies": {
    "@opero/shared": "workspace:*",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@opero/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.10",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
